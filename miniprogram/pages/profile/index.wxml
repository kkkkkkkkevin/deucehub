<!-- pages/profile/index.wxml - 用户信息页 -->
<view class="profile-page">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="header-rainbow"></view>
    <view class="header-content">
      <image class="user-avatar" src="{{avatar}}" mode="aspectFill"></image>
      <view class="user-info">
        <view class="user-name" bindtap="onEditName">
          <text>{{nickname || '点击设置昵称'}}</text>
          <text class="edit-icon">›</text>
        </view>
        <view class="user-ntrp" bindtap="onEditNTRP">
          <view class="ntrp-badge">NTRP {{ntrpLevel}}</view>
          <text class="ntrp-name">{{ntrpName}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-value">{{totalPoints}}</text>
      <text class="stat-label">总积分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{matchCount}}</text>
      <text class="stat-label">战绩场数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{winRate}}%</text>
      <text class="stat-label">胜率</text>
    </view>
  </view>

  <!-- 网球人格 -->
  <view class="section-card" bindtap="onViewPersonality">
    <view class="section-header">
      <text class="section-title">我的网球人格</text>
      <text class="section-arrow">›</text>
    </view>
    <view class="personality-content" wx:if="{{mbtiResult}}">
      <image class="personality-img" src="{{mbtiResult.img}}" mode="aspectFit"></image>
      <view class="personality-info">
        <text class="personality-name">{{mbtiResult.name}}</text>
        <view class="personality-fire">
          <text class="fire-label">火力值</text>
          <text class="fire-val">{{mbtiResult.firePower}}</text>
        </view>
      </view>
    </view>
    <view class="empty-content" wx:else>
      <text class="empty-text">还未测试，点击前往测试 ›</text>
    </view>
  </view>

  <!-- 我的积分 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">我的积分</text>
    </view>
    <view class="points-content">
      <view class="points-row">
        <text class="points-label">总积分</text>
        <text class="points-value">{{totalPoints}}</text>
      </view>
      <view class="points-row">
        <text class="points-label">本站积分</text>
        <text class="points-value">{{eventPoints}}</text>
      </view>
    </view>
  </view>

  <!-- 战绩 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">我的战绩</text>
      <text class="record-count" wx:if="{{matchRecords.length > 0}}">{{matchRecords.length}}场</text>
    </view>
    <view class="records-content" wx:if="{{matchRecords.length > 0}}">
      <view class="record-item" wx:for="{{matchRecords}}" wx:key="id">
        <view class="record-left">
          <text class="record-date">{{item.date}}</text>
          <text class="record-opponent">vs {{item.opponent}}</text>
        </view>
        <view class="record-right">
          <text class="record-score">{{item.score}}</text>
          <view class="record-result {{item.win ? 'win' : 'lose'}}">{{item.win ? '胜' : '负'}}</view>
        </view>
      </view>
    </view>
    <view class="empty-content" wx:else>
      <text class="empty-text">暂无战绩记录</text>
    </view>
  </view>

  <!-- NTRP等级说明 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">NTRP等级说明</text>
    </view>
    <view class="ntrp-list">
      <view class="ntrp-item {{ntrpLevel === item.value ? 'current' : ''}}" wx:for="{{ntrpLevels}}" wx:key="value" bindtap="onSelectNTRP" data-value="{{item.value}}">
        <view class="ntrp-level-badge">{{item.value}}</view>
        <view class="ntrp-info">
          <text class="ntrp-level-name">{{item.name}}</text>
          <text class="ntrp-level-desc">{{item.desc}}</text>
        </view>
        <view class="ntrp-check" wx:if="{{ntrpLevel === item.value}}">✓</view>
      </view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
