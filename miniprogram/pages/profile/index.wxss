/* pages/profile/index.wxss */
.profile-page {
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
}

/* 头部 */
.profile-header {
  margin: 0 -32rpx 24rpx;
  background: linear-gradient(135deg, #2d5a27 0%, #1e3d1a 100%);
  padding: 56rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.header-rainbow {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #1dd1a1, #5f27cd, #ff9ff3);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: #fff;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-icon {
  font-size: 32rpx;
  color: rgba(255,255,255,0.5);
}

.user-ntrp {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ntrp-badge {
  background: #d4e157;
  color: #2d5a27;
  font-size: 24rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.ntrp-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 数据概览 */
.stats-row {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2d5a27;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  background: #f0f0f0;
}

/* 卡片通用 */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d5a27;
}

.section-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.record-count {
  font-size: 24rpx;
  color: #999;
}

/* 网球人格 */
.personality-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.personality-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.personality-info {
  flex: 1;
}

.personality-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
}

.personality-fire {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.fire-label {
  font-size: 24rpx;
  color: #999;
}

.fire-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #d4a843;
}

/* 空状态 */
.empty-content {
  padding: 24rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}

/* 积分 */
.points-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.points-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-label {
  font-size: 30rpx;
  color: #666;
}

.points-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #2d5a27;
}

/* 战绩 */
.records-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-opponent {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.record-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-score {
  font-size: 30rpx;
  color: #666;
  font-weight: 600;
}

.record-result {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.record-result.win {
  background: #2d5a27;
}

.record-result.lose {
  background: #ccc;
}

/* NTRP列表 */
.ntrp-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ntrp-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.ntrp-item.current {
  background: rgba(45, 90, 39, 0.06);
}

.ntrp-item:active {
  background: #f5f5f5;
}

.ntrp-level-badge {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #2d5a27;
  background: rgba(45, 90, 39, 0.1);
  padding: 8rpx 0;
  border-radius: 8rpx;
}

.ntrp-info {
  flex: 1;
}

.ntrp-level-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.ntrp-level-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.ntrp-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2d5a27;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
