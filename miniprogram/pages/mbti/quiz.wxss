/* pages/mbti/quiz.wxss */
.quiz-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 进度条 */
.quiz-header {
  padding: 24rpx 0 32rpx;
}

.progress-bar {
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2d5a27, #5b2c83);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d5a27;
}

.dim-tag {
  font-size: 24rpx;
  color: #5b2c83;
  background: rgba(91, 44, 131, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* 题目区 */
.question-area {
  flex: 1;
  padding: 40rpx 0;
}

.question-area.slide-in {
  animation: slideIn 0.35s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.question-num {
  font-size: 80rpx;
  font-weight: 900;
  color: rgba(45, 90, 39, 0.08);
  line-height: 1;
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 56rpx;
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-card {
  display: flex;
  align-items: center;
  background: #fff;
  border: 4rpx solid #e8e8e8;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  transition: all 0.25s ease;
  position: relative;
}

.option-card:active {
  transform: scale(0.98);
}

.option-card.selected-a {
  border-color: #2d5a27;
  background: rgba(45, 90, 39, 0.04);
  box-shadow: 0 4rpx 20rpx rgba(45, 90, 39, 0.15);
}

.option-card.selected-b {
  border-color: #5b2c83;
  background: rgba(91, 44, 131, 0.04);
  box-shadow: 0 4rpx 20rpx rgba(91, 44, 131, 0.15);
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  text-transform: uppercase;
}

.selected-a .option-badge {
  background: #2d5a27;
  color: #fff;
}

.selected-b .option-badge {
  background: #5b2c83;
  color: #fff;
}

.option-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d4e157;
  color: #2d5a27;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

/* 底部 */
.quiz-footer {
  padding: 32rpx 0 48rpx;
  display: flex;
  align-items: center;
}

.btn-back {
  background: transparent;
  color: #999;
  font-size: 28rpx;
  padding: 16rpx 0;
  line-height: 1.5;
}

.btn-back::after {
  border: none;
}

.footer-hint {
  font-size: 24rpx;
  color: #ccc;
}
