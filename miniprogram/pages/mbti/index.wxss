/* pages/mbti/index.wxss */
.mbti-cover {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 Hero */
.hero-section {
  background: linear-gradient(180deg, #2d5a27 0%, #1e3d1a 100%);
  padding: 60rpx 32rpx 80rpx;
  text-align: center;
  position: relative;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.rainbow-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #1dd1a1, #5f27cd, #ff9ff3);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  color: #d4e157;
  margin-top: 12rpx;
  font-weight: 500;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 16rpx;
}

/* 四维度 */
.dimensions-section {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  margin-top: -50rpx;
  gap: 16rpx;
}

.dim-card {
  flex: 1 1 calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  text-align: center;
}

.dim-name {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.dim-poles {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.pole-left {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d5a27;
}

.pole-vs {
  font-size: 20rpx;
  color: #ccc;
  font-weight: 600;
}

.pole-right {
  font-size: 30rpx;
  font-weight: 700;
  color: #5b2c83;
}

/* 开始按钮 */
.start-section {
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
}

.btn-start {
  width: 100%;
  font-size: 36rpx;
  padding: 28rpx 0;
}

.test-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 16物种预览 */
.species-preview {
  padding: 0 24rpx;
}

.species-preview .section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d5a27;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.species-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.species-item {
  width: calc(25% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: transform 0.2s;
}

.species-item:active {
  transform: scale(0.95);
}

.species-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.species-name {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #333;
  margin-top: 8rpx;
}

.fire-power {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.fire-label {
  font-size: 18rpx;
  color: #ccc;
}

.fire-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #d4a843;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
  font-size: 22rpx;
  color: #ccc;
}
