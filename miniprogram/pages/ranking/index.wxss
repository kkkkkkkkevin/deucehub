/* pages/ranking/index.wxss */
.ranking-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 */
.ranking-header {
  background: linear-gradient(135deg, #2d5a27 0%, #1e3d1a 100%);
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.header-rainbow {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #1dd1a1, #5f27cd, #ff9ff3);
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #d4e157;
  margin-top: 8rpx;
  letter-spacing: 6rpx;
  font-weight: 500;
}

/* 切换 */
.tab-switcher {
  display: flex;
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #2d5a27, #3a7a32);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(45, 90, 39, 0.3);
}

/* 领奖台 */
.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx 24rpx 16rpx;
  gap: 16rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.podium-1 { width: 220rpx; }
.podium-2 { width: 200rpx; }
.podium-3 { width: 200rpx; }

.podium-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}

.podium-1 .podium-avatar { width: 120rpx; height: 120rpx; font-size: 52rpx; }

.gold-bg { background: linear-gradient(135deg, #d4a843, #f0c060); }
.silver-bg { background: linear-gradient(135deg, #999, #bbb); }
.bronze-bg { background: linear-gradient(135deg, #cd7f32, #e0975a); }

.podium-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}

.podium-score {
  font-size: 32rpx;
  font-weight: 800;
  color: #2d5a27;
}

.podium-medal {
  position: absolute;
  top: -8rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
}

.podium-medal.gold { background: #d4a843; }
.podium-medal.silver { background: #aaa; }
.podium-medal.bronze { background: #cd7f32; }

.podium-bar {
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
  margin-top: 12rpx;
}

.bar-1 { height: 120rpx; background: linear-gradient(180deg, #d4a843, #c49a3a); }
.bar-2 { height: 90rpx; background: linear-gradient(180deg, #bbb, #999); }
.bar-3 { height: 70rpx; background: linear-gradient(180deg, #cd7f32, #b0702a); }

/* 列表 */
.ranking-table {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.table-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(45, 90, 39, 0.06);
  border-bottom: 2rpx solid #e8e8e8;
}

.table-header text {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d5a27;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
  transition: background 0.2s;
}

.table-row:active {
  background: #f9f9f9;
}

.table-row:last-child {
  border-bottom: none;
}

.col-rank {
  width: 100rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: 600;
}

.rank-num {
  color: #666;
}

.col-player {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.player-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2d5a27, #5b2c83);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.col-score {
  width: 120rpx;
  text-align: right;
  font-size: 32rpx;
  font-weight: 800;
  color: #2d5a27;
}

.ranking-footer {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: #ccc;
}
